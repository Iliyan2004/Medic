# Copy to .env and fill in. Never commit .env.
# ── Required in production (NODE_ENV=production refuses to start without them) ──
NODE_ENV=production
# 32-byte keys as 64 hex chars. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store a copy OUTSIDE the server (password manager / secret store). Lose them = lose all encrypted records.
DATA_KEY=
HMAC_KEY=

# ── Web ──
PORT=3000
FORCE_HTTPS=1
TRUST_PROXY=loopback

# ── Maps (public pk.* token; restrict it to your domain in the Mapbox dashboard) ──
MAPBOX_TOKEN=

# ── Push reminders (optional; generated into data/vapid.json if empty). Keep stable once users subscribe. ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.pk

# ── Backups ──
BACKUP_DIR=/var/backups/sehatyab
BACKUP_KEEP=14
# BACKUPS=off

# ── WhatsApp Cloud API (optional) ──
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=sehatyab_alert

# ── Demo data (never on a real deployment) ──
# SEED_DEMO=1
